# Chat IR — environment variables
# Copy this file to `.env.local` and fill in real values. See README.md / DEPLOYMENT.md /
# SUPABASE_SETUP.md / VERCEL_SETUP.md for the full setup walkthrough for each of these.

# --- Supabase (required) ---
# Project Settings > API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, bypasses RLS. Never expose to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption (required) ---
# AES-256-GCM key used to encrypt Retell API keys at rest (src/lib/encryption.ts).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- App URL (required in production) ---
# Used to build absolute URLs (e.g. Stripe success/cancel redirects). In local dev this
# defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Retell AI (optional at the environment level) ---
# Per-tenant Retell API keys are stored encrypted in the `tenants` table (connected via
# the platform-admin "Voice Provider" modal at /tenant-settings) — most deployments do
# NOT need these. RETELL_WEBHOOK_SECRET verifies inbound Retell webhook signatures;
# RETELL_API_KEY is kept only as a legacy fallback shared webhook secret if the dedicated
# secret below is unset. RETELL_WEBHOOK_VERIFY=false disables signature verification
# (local/dev only — never disable in production).
RETELL_API_KEY=
RETELL_WEBHOOK_SECRET=
RETELL_WEBHOOK_VERIFY=true
NEXT_PUBLIC_RETELL_API_KEY=

# --- Stripe (required for billing — see docs/superpowers/specs/2026-09-14-stripe-billing-design.md) ---
# Test-mode keys from the Stripe dashboard. STRIPE_PRICE_ID is produced by running
# `npx tsx scripts/stripe-setup.ts` once (idempotent) after setting STRIPE_SECRET_KEY.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` (local) or the Stripe dashboard's
# webhook endpoint settings (production, pointed at /api/webhooks/stripe).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Chat widget rate limiting (optional, opt-in) ---
# Off by default. When enabled, applies a best-effort per-IP rate limit to the public
# embeddable chat widget endpoint (src/app/api/widget/chat/message/route.ts).
WIDGET_RATE_LIMIT_ENABLED=false
WIDGET_RATE_LIMIT_PER_MINUTE=30

# --- LLM model allowlist (optional) ---
# Comma-separated list of model IDs platform admins are allowed to assign to agents
# (src/lib/models.ts). Leave unset to allow the full Retell model library.
ALLOWED_LLM_MODELS=
